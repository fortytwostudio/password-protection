{# Inherit the blocks and their content from the master layout. #}
{% extends "protected-page/_layout.twig" %}

{# Get Errors #}
{% set error = craft.app.session.getFlash("error") %}

{# Get url params #}
{% set pageUrl = craft.app.request.getParam("ref") %}
{% set pageId = craft.app.request.getParam("refId") %}

{# Check if the page is still protected #}
{% set stillProtected = craft.entryPassword.stillProtected(pageId) %}
{% if not stillProtected %}
    {% redirect pageUrl %}
{% endif %}

{# Get Content #}
{% set passwordContent = craft.entryPassword.getContent() %}

{% block body %}
    {% embed "_organisms/_main" with {
        attributes: {
            class: [
                "flex",
                "justify-center",
                "items-center",
                "h-dvh",
            ]
        }
    } %}
        {% block content %}
            <div class="max-w-4xl w-full mx-auto bg-white p-8 shadow" data-theme="white">
                {% include "_atoms/_heading" with {
		            text: passwordContent.heading | default("Protected Page"),
		            attributes: {
                        wrapper: {
                            class: [
								"font-h2",
                                passwordContent.content ? "mb-4" : "mb-12",
                            ]
                        }
                    }
	            } %}

				{% include "_atoms/_paragraph" with {
		            text: passwordContent.content | default(null),
	            } %}

                <form
                    id="login-form"
                    method="post"
                    action="{{ pageUrl }}"
                >

                    {{ csrfInput({ name: "csrf-token" }) }}

                    {{ field("text", {
                        type: "password",
                        id: "password",
                        name: "password",
                        placeholder: "Password" | t("app"),
                        autocomplete: "current-password",
                        inputAttributes: {
                            class: [
                                "mb-6",
                            ],
                            aria: {
                                label: "Password" | t("app"),
                                required: "true",
                            },
                        },
                    }) }}

					{% if error %}
						<div id="login-errors" role="alert" class="text-red mb-4">
							<p>{{ error }}</p>
						</div>
					{% endif %}

                    {% include "_atoms/_button" with {
                        tag: "button",
                        text: "Submit" | t("app"),
                        type: "submit",
                    } only %}
                </form>
            </div>

        {% endblock %}
    {% endembed %}
{% endblock %}
